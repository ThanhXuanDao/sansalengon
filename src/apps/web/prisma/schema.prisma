generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id               String            @id @default(cuid())
  name             String
  price            Int               // giá sau khuyến mãi (currentPrice)
  originalPrice    Int?              // giá gốc trước khuyến mãi
  commission       Int               @default(0)
  rating           Float             @default(0)
  discountPct      Int?
  imageUrl         String
  imageAlt         String
  productUrl            String
  affiliateUrl          String?   // AT (AccessTrade) tracking link
  platformAffiliateUrl  String?   // link affiliate của platform (Shopee an_redir, Lazada c.lazada.vn)
  source           String            @default("shopee")
  sourceLogoUrl    String?                               // logo của nguồn — từ AtCampaign.logoUrl khi sync
  externalId       String?
  lastSyncedAt     DateTime?
  categoryId       String
  brandId          String?                               // FK Brand — để filter theo thương hiệu
  atCampaignId     String?                               // FK AtCampaign — để filter theo campaign
  isFeatured       Boolean           @default(false)
  isSoldOut        Boolean           @default(false)
  createdAt        DateTime          @default(now())

  @@unique([source, externalId], map: "Product_source_externalId_key")
  @@index([brandId])
  @@index([atCampaignId])
  clicks           ClickLog[]
  priceHistory     PriceHistory[]
  platformProducts PlatformProduct[]
  productMatches   ProductMatch[]
  embedding        ProductEmbedding?
  category         Category          @relation(fields: [categoryId], references: [id])
  brand            Brand?            @relation(fields: [brandId], references: [id])
}

model PriceHistory {
  id         String    @id @default(cuid())
  productId  String
  price      Int
  platformId String?
  recordedAt DateTime  @default(now())
  product    Product   @relation(fields: [productId], references: [id])
  platform   Platform? @relation(fields: [platformId], references: [id])

  @@index([productId, recordedAt])
  @@index([productId, platformId, recordedAt])
}

// ── Multi-platform price comparison ─────────────────────────

model Platform {
  id               String            @id  // "shopee" | "lazada" | "tiki" | "tiktok"
  name             String
  logoUrl          String?
  baseUrl          String
  isActive         Boolean           @default(true)
  platformProducts PlatformProduct[]
  priceHistory     PriceHistory[]
}

model PlatformProduct {
  id                String   @id @default(cuid())
  productId         String
  platformId        String
  platformProductId String
  platformUrl       String
  currentPrice      Int
  originalPrice     Int?
  inStock           Boolean  @default(true)
  rating            Float?
  soldCount         Int?
  lastChecked       DateTime @updatedAt

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  platform Platform @relation(fields: [platformId], references: [id])

  @@unique([productId, platformId])
  @@index([productId])
  @@index([platformId])
}

model ProductMatch {
  id             String      @id @default(cuid())
  productId      String
  platformId     String
  candidateUrl   String
  candidateName  String?
  candidatePrice Int?
  confidence     Float
  status         MatchStatus @default(PENDING)
  confirmedBy    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, platformId])
  @@index([status])
}

enum MatchStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model Category {
  id             String    @id               // "fashion" — slug URL-safe
  name           String
  emoji          String    @default("🏷️")
  status         String    @default("draft") // "active" | "draft" | "paused"
  description    String?
  metaKeywords   String?
  sortOrder      Int       @default(0)
  postPrefix     String?
  hashtags       String?
  zaloOaId       String?
  syncEnabled    Boolean   @default(true)
  launchedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  products       Product[]

  @@map("Niche")
}

model ClickLog {
  id        String   @id @default(cuid())
  productId String
  source    String?  // "website" | "zalo" | "facebook" | "direct"
  referer   String?
  clickedAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])

  @@index([productId, clickedAt])
  @@index([clickedAt])
}

model AppSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model ProductEmbedding {
  id        String   @id @default(cuid())
  productId String   @unique
  embedding String   // JSON-serialized float array
  model     String   // e.g. "text-embedding-3-small" or "text-embedding-004"
  dims      Int      // vector dimensions
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Feedback {
  id             String   @id @default(cuid())
  name           String
  email          String
  message        String
  sentiment      String?  // "positive" | "negative" | "neutral" | "suggestion"
  sentimentScore Float?   // 0.0–1.0 confidence
  createdAt      DateTime @default(now())
}

model Coupon {
  id             String    @id @default(cuid())
  source         String    @default("accesstrade")  // "accesstrade" | "shopee" | "tiki" | "lazada" | "manual"
  platform       String?                             // "shopee" | "tiki" | "lazada" — sàn áp dụng coupon
  externalId     String?                             // ID từ nguồn nếu có
  nicheId        String?                             // null = áp dụng mọi ngách
  merchant       String
  merchantLogo   String?
  imageUrl       String?                             // Banner/ảnh coupon từ nguồn
  code           String?                             // null = không có code (click link trực tiếp)
  description    String
  terms          String?                             // Điều kiện sử dụng chi tiết
  discountValue  Int                                 // số tiền hoặc % giảm
  discountType   String    @default("percent")       // "percent" | "fixed"
  minOrderValue  Int?
  maxDiscount    Int?
  affiliateUrl   String
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  clickCount     Int       @default(0)               // lượt click "Lấy Mã"
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([nicheId, isActive, expiresAt])
  @@index([isActive, expiresAt])
}

model BroadcastLog {
  id          String   @id @default(cuid())
  channel     String                          // "zalo"
  nicheId     String?                         // null = tất cả ngách
  productIds  String                          // JSON array
  messageText String
  status      String                          // "sent" | "failed"
  error       String?
  sentAt      DateTime @default(now())

  @@index([channel, sentAt])
}

model AppLog {
  id        String   @id @default(cuid())
  level     String   // "error" | "warn" | "info" | "debug"
  message   String
  context   String?  // JSON-serialized extra data
  source    String?  // feature: "auth", "deal-sync", "niche-config", "zalo-broadcast", etc.
  app       String?  // origin: "web-public" | "web-admin" | "api" | "api-sync" | "api-distribute"
  trigger   String?  // "cron" | "manual" | "user" | "system"
  createdAt DateTime @default(now())

  @@index([level, createdAt])
  @@index([app, createdAt])
  @@index([source, createdAt])
  @@index([createdAt])
}

model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

// ── Sync Job management ──────────────────────────────────────

model SyncJob {
  id                String       @id @default(cuid())
  key               String       @unique
  name              String
  description       String?
  config            String       @default("{}") // JSON: configurable params
  isEnabled         Boolean      @default(true)
  scheduleEnabled   Boolean      @default(false)
  scheduleCron      String?      // e.g. "0 0 * * *"
  scheduleNextRunAt DateTime?    // precomputed, updated after each run
  lastRunAt         DateTime?
  lastStatus        String?      // "success" | "failed" | "partial" | "running"
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  runs              SyncJobRun[]

  @@index([scheduleEnabled, scheduleNextRunAt])
}

model SyncJobRun {
  id           String    @id @default(cuid())
  jobId        String
  job          SyncJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  triggerType  String    @default("manual") // "manual" | "auto"
  triggeredBy  String?
  status       String    @default("running") // "running" | "success" | "failed" | "partial"
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  durationMs   Int?
  itemsTotal   Int?
  itemsSuccess Int?
  itemsFailed  Int?
  source       String?
  niche        String?
  summary      String?
  errors       String?   // JSON: { item?: string; reason: string }[]
  meta         String?   // JSON: extra metadata

  @@index([jobId, startedAt(sort: Desc)])
  @@index([startedAt(sort: Desc)])
}

// ── Brand (thương hiệu) ──────────────────────────────────────
// Derive từ AtCampaign.merchant — 1 brand có nhiều campaign

model Brand {
  id        String       @id @default(cuid())
  name      String                            // "Tiki", "CellphoneS"
  slug      String       @unique              // "tiki", "cellphones"
  logoUrl   String?
  createdAt DateTime     @default(now())

  campaigns AtCampaign[]
  products  Product[]

  @@index([slug])
}

// ── AccessTrade campaign tracking ────────────────────────────
// Upsert mỗi lần sync chạy — persist để debug offline

model AtCampaign {
  id             String   @id              // AT campaign ID (string từ AT)
  name           String
  merchant       String
  url            String
  approval       String                    // "successful" | "pending" | "rejected"
  cookieDuration Int?
  status         Int
  campaignType   String   @default("product")  // "product" | "app" | "link" | "website"
  ctaTitle       String?
  ctaDescription String?
  ctaImageUrl    String?
  ctaLabel       String?
  logoUrl        String?
  ogImageUrl     String?                   // og:image từ landing page của campaign
  description    String?
  category       String?
  commission     String?
  lastSeenAt     DateTime                  // lần sync gần nhất thấy campaign này
  createdAt      DateTime @default(now())
  brandId        String?
  brand          Brand?   @relation(fields: [brandId], references: [id])

  nicheMatches   AtCampaignNicheMatch[]
  banners        AtCampaignBanner[]

  @@index([brandId])
}

model AtCampaignBanner {
  id            String   @id              // AT banner ID
  campaignId    String
  imageUrl      String
  width         Int?
  height        Int?
  type          String?
  affiliateLink String?
  syncedAt      DateTime @default(now())

  campaign      AtCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model AtCampaignNicheMatch {
  id         String     @id @default(cuid())
  campaignId String
  nicheId    String
  matchedAt  DateTime   @default(now())

  campaign   AtCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, nicheId])
  @@index([nicheId])
}

// ── Website scraper source configs ───────────────────────────
// Mỗi row = 1 website nguồn — config scraper, không chứa logic scraping

model SyncSource {
  id                String    @id @default(cuid())
  name              String
  slug              String    @unique
  baseUrl           String
  enabled           Boolean   @default(true)
  config            String    @default("{}")
  description       String?
  icon              String?   // emoji hoặc URL ảnh — hiển thị ở public source filter
  scheduleCron      String?
  scheduleEnabled   Boolean   @default(false)
  scheduleNextRunAt DateTime?
  lastRunAt         DateTime?
  lastRunStatus     String?   // "success" | "failed" | "running"
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([scheduleEnabled, scheduleNextRunAt])
}

// ── Per-niche platform integration config ────────────────────
// Runtime-configurable qua Admin UI — không cần sửa YAML hay restart

model NicheIntegration {
  id             String   @id @default(cuid())
  nicheId        String   // "fashion" | "electronics" — id từ niches.yaml
  platform       String   // "tiki" | "sendo" | future platforms
  enabled        Boolean  @default(true)   // master toggle cho platform này
  atEnabled      Boolean  @default(true)   // Cách 1: tìm AT campaign match platform
  directEnabled  Boolean  @default(true)   // Cách 2: gọi thẳng platform API
  directFallback Boolean  @default(true)   // true = Cách 2 chỉ chạy khi Cách 1 có 0 kết quả
  campaignId     String?  // override AT campaign ID (bỏ trống = auto-detect theo tên)
  updatedAt      DateTime @updatedAt

  @@unique([nicheId, platform])
  @@index([nicheId])
}
