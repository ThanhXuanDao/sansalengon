generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id           String         @id @default(cuid())
  name         String
  price        Int
  commission   Int            @default(0)
  rating       Float          @default(0)
  discountPct  Int?
  imageUrl     String
  imageAlt     String
  shopeeUrl    String
  categoryId   String
  isFeatured   Boolean        @default(false)
  isSoldOut    Boolean        @default(false)
  createdAt    DateTime       @default(now())
  clicks       ClickLog[]
  priceHistory PriceHistory[]
  category     Category       @relation(fields: [categoryId], references: [id])
}

model PriceHistory {
  id         String   @id @default(cuid())
  productId  String
  price      Int
  recordedAt DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id])

  @@index([productId, recordedAt])
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  icon     String    @default("LayoutGrid")
  products Product[]
}

model ClickLog {
  id        String   @id @default(cuid())
  productId String
  clickedAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
}

model AppSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model Feedback {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model Coupon {
  id             String    @id @default(cuid())
  source         String    @default("accesstrade")  // "accesstrade" | "manual"
  externalId     String?                             // ID từ AccessTrade nếu có
  nicheId        String?                             // null = áp dụng mọi ngách
  merchant       String
  merchantLogo   String?
  code           String?                             // null = không có code (click link trực tiếp)
  description    String
  discountValue  Int                                 // số tiền hoặc % giảm
  discountType   String    @default("percent")       // "percent" | "fixed"
  minOrderValue  Int?
  maxDiscount    Int?
  affiliateUrl   String
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([nicheId, isActive, expiresAt])
  @@index([isActive, expiresAt])
}
