# Database
DATABASE_URL="postgresql://user:password@localhost:5432/affiliate"

# Shopee
# Shopee Affiliate ID — dùng cho syncMode="scrape" (an_redir link)
# Lấy từ: affiliate.shopee.vn → Tài khoản của tôi → ID
# Fallback nếu không set affiliateId trong SyncSource.config
SHOPEE_AFFILIATE_ID=

# Proxy cho Playwright scraper (adidas.com.vn và các site dùng Akamai WAF)
# Bắt buộc để scrape adidas.com.vn — Akamai chặn datacenter/Docker IPs
# Format giống SHOPEE_PROXY_URL — có thể dùng chung proxy
SCRAPER_PROXY_URL=

# Lazada Affiliate Open Platform (lấy từ https://open.lazada.com/)
# Tạo App → lấy API Key (app_key) và App Secret (app_secret)
# Nếu không có, đổi lazadaSyncMode thành "at" trong Admin → Sources → Lazada
LAZADA_APP_KEY=
LAZADA_APP_SECRET=

# AccessTrade (lấy từ https://accesstrade.vn/publisher/api)
ACCESSTRADE_ACCESS_KEY=
ACCESSTRADE_BASE_URL=https://api.accesstrade.vn/v1
ACCESSTRADE_REGION=VN

# Zalo OA (lấy từ https://developers.zalo.me/docs/api/official-account-api)
# ACCESS_TOKEN + REFRESH_TOKEN chỉ dùng để SEED LẦN ĐẦU vào DB.
# Sau khi API server khởi động, token được lưu trong bảng AppSetting.
# Bạn có thể xoá 2 dòng này khỏi .env sau lần chạy đầu tiên.
# Quản lý token sau này: Admin → Zalo OA → tab 🔑 Token
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_REFRESH_TOKEN=
ZALO_OA_APP_ID=
ZALO_OA_APP_SECRET=

# ── AI Providers (tất cả đều tùy chọn — chọn 1 hoặc nhiều) ──────────────────
# Quản lý provider trong Admin → AI Config (thay đổi không cần restart)
# Thứ tự khuyên dùng để tiết kiệm chi phí:
#   1. Gemini Flash (MIỄN PHÍ 1M tokens/ngày) → https://aistudio.google.com/apikey
#   2. DeepSeek (CỰC RẺ $0.14/1M tokens)    → https://platform.deepseek.com/api_keys
#   3. OpenAI gpt-4o-mini ($0.15/1M tokens)  → https://platform.openai.com/api-keys
#   4. Claude Haiku ($0.80/1M tokens)        → https://console.anthropic.com/settings/keys

GOOGLE_AI_API_KEY=      # Gemini Flash — free tier, recommended
DEEPSEEK_API_KEY=       # DeepSeek Chat — nearly free
OPENAI_API_KEY=         # GPT-4o mini + DALL-E image generation
ANTHROPIC_API_KEY=      # Claude Haiku/Sonnet — highest quality

# Image generation (cấu hình trong Admin → AI Config)
# Pollinations.ai: miễn phí, không cần key
# DALL-E 3: dùng OPENAI_API_KEY ở trên, ~$0.04/image
# Stability AI: https://platform.stability.ai/account/keys
STABILITY_API_KEY=      # Stability AI SDXL — $0.01/image

# App
WEB_URL=http://localhost:3000
PORT=4000
NODE_ENV=development

# Deploy mode
# DISABLE_ADMIN=true  → public-only: ẩn toàn bộ /admin và /api/admin (dùng khi deploy public site lên hosting)
# Bỏ trống hoặc =false → full deploy (admin + public trên cùng 1 server)
DISABLE_ADMIN=false

# Internal API communication (Web → NestJS API)
# Web dùng API_URL để gọi trigger endpoint của NestJS
# API_INTERNAL_SECRET: Bearer token để bảo vệ /sync/* endpoints
# Nếu để trống thì endpoints không yêu cầu auth (chỉ dùng trong dev)
API_URL=http://localhost:4000
API_INTERNAL_SECRET=
# Extension dùng API_INTERNAL_SECRET để auth với /sync/extension-bulk-capture
# Sau khi set .env.local, chạy: node scripts/gen-extension-config.mjs
# → tự động tạo src/apps/extension/config.js (gitignored)

# Website URL — dùng cho sitemap.xml, robots.txt, OG tags
# Prod: https://your-domain.com (không có dấu / ở cuối)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
